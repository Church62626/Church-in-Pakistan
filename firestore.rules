rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public, read-only content. The site renders anonymously, so a deny-by-
    // default ruleset would surface as "could not be loaded" rather than an
    // obvious error. Only PUBLISHED documents are exposed.
    match /books/{id} {
      allow read: if resource.data.published == true;
      allow write: if false; // written by the Admin SDK (scripts/sync-book.mjs)
    }

    match /hymns/{id} {
      allow read: if resource.data.published == true;
      allow write: if false; // written by the Admin SDK (scripts/sync-hymns.mjs)
    }

    // The RSVP form submits anonymously and only needs the write to succeed;
    // the event id is echoed back to the parent over the emitted event. Reads
    // are closed so attendee names and phone numbers are never publicly listable.
    match /rsvps/{id} {
      allow create: if request.resource.data
        .keys().hasAll(['name', 'phone', 'attendees', 'eventId', 'timestamp']);
      allow read, update, delete: if false;
    }

    // Orders hold names, addresses and a payment transaction reference, so they
    // are write-only from the client too.
    match /orders/{id} {
      allow create: if request.resource.data
        .keys().hasAll(['fullName', 'items', 'totalAmount', 'timestamp']);
      allow read, update, delete: if false;
    }

    // Premium catalogue: the same anonymous-write, never-readable pattern.
    // These hold names and contact details, so reads stay closed.
    match /premiumBooks/{id} {
      allow read: if resource.data.published == true;
      allow write: if false; // written by the Admin SDK
    }

    match /bookRequests/{id} {
      allow create: if request.resource.data
        .keys().hasAll(['bookId', 'bookTitle', 'name', 'contact', 'status', 'timestamp']);
      allow read, update, delete: if false;
    }

    // Everything else is private by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}